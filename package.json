{
  "name": "docuchat",
  "version": "1.0.0",
  "description": "TypeScript Express application with Prisma ORM",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run prisma:generate && tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "npm run prisma:generate && npm run db:push && tsx src/server.ts",
    "serve": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "test": "echo \"No test suite configured\"",
    "init": "npm run prisma migrate dev --name init"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/alevel7/docuChat"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true,
    "esbuild@0.28.2": true
  }
}
